# The full match history is about 330 MB and the backfill can rebuild it. Only
# the 2026 season and its manifest are kept, for the analysis script.
/tools/mathematical_engine/data_lake/*
!/tools/mathematical_engine/data_lake/raw_historical/
/tools/mathematical_engine/data_lake/raw_historical/*
!/tools/mathematical_engine/data_lake/raw_historical/2026/
!/tools/mathematical_engine/data_lake/manifests/
/tools/mathematical_engine/data_lake/manifests/*
!/tools/mathematical_engine/data_lake/manifests/weekly_manifest.json
/tools/mathematical_engine/.backup_v1
/tools/qualitative_research/cache
/tools/qualitative_research/debug
/tools/fixture_scene/cache
/Reporting/*.pdf
# Frozen old-system snapshot at legacy/ (commit dccb09c). Shared engine
# artifacts stay in the parent tree — do not copy models/data into legacy/.
/legacy/tools/mathematical_engine/data_lake
/legacy/tools/mathematical_engine/feature_store
/legacy/tools/mathematical_engine/models
/legacy/tools/mathematical_engine/.backup_v1
/legacy/tools/qualitative_research/cache
/legacy/tools/qualitative_research/debug
/legacy/tools/fixture_scene/cache
**/.venv/
**/.uv-python/
**/.uv-cache/
__pycache__/
*.pyc
.env
.DS_Store
